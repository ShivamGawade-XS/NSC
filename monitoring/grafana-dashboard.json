{
  "annotations": {
    "list": []
  },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "liveNow": false,
  "panels": [
    {
      "collapsed": false,
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "id": 1,
      "title": "HTTP Request Throughput (req/sec)",
      "type": "timeseries",
      "targets": [
        {
          "expr": "sum(rate(Tellura_http_requests_total[1m])) by (status_code)",
          "legendFormat": "Status {{status_code}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": { "drawStyle": "line", "lineInterpolation": "smooth", "fillOpacity": 15 },
          "unit": "reqps"
        }
      }
    },
    {
      "collapsed": false,
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "id": 2,
      "title": "Request Latency Quantiles (p50, p95, p99)",
      "type": "timeseries",
      "targets": [
        {
          "expr": "histogram_quantile(0.50, sum(rate(Tellura_http_request_duration_seconds_bucket[1m])) by (le))",
          "legendFormat": "p50 (Median)"
        },
        {
          "expr": "histogram_quantile(0.95, sum(rate(Tellura_http_request_duration_seconds_bucket[1m])) by (le))",
          "legendFormat": "p95 (SLO Target < 0.5s)"
        },
        {
          "expr": "histogram_quantile(0.99, sum(rate(Tellura_http_request_duration_seconds_bucket[1m])) by (le))",
          "legendFormat": "p99"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": { "drawStyle": "line", "lineInterpolation": "smooth" },
          "unit": "s"
        }
      }
    },
    {
      "collapsed": false,
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 8 },
      "id": 3,
      "title": "Availability SLO (5xx Error Ratio)",
      "type": "gauge",
      "targets": [
        {
          "expr": "1 - (sum(rate(Tellura_http_requests_total{status_code=~\"5..\"}[5m])) or vector(0)) / (sum(rate(Tellura_http_requests_total[5m])) or vector(1))",
          "legendFormat": "Availability"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "min": 0.95,
          "max": 1.0,
          "unit": "percentunit",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "yellow", "value": 0.99 },
              { "color": "green", "value": 0.999 }
            ]
          }
        }
      }
    },
    {
      "collapsed": false,
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 8 },
      "id": 4,
      "title": "Active In-Flight Requests",
      "type": "stat",
      "targets": [
        {
          "expr": "Tellura_active_requests",
          "legendFormat": "In-Flight"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 15 },
              { "color": "red", "value": 25 }
            ]
          }
        }
      }
    },
    {
      "collapsed": false,
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 8 },
      "id": 5,
      "title": "Process Memory RSS vs 2GB Limit",
      "type": "gauge",
      "targets": [
        {
          "expr": "Tellura_process_memory_rss_bytes",
          "legendFormat": "RSS Memory"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "min": 0,
          "max": 2147483648,
          "unit": "bytes",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 1288490188 },
              { "color": "red", "value": 1717986918 }
            ]
          }
        }
      }
    },
    {
      "collapsed": false,
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 16 },
      "id": 6,
      "title": "Cache Hit Rate (SQLite L2 Cache)",
      "type": "timeseries",
      "targets": [
        {
          "expr": "sum(rate(Tellura_cache_hits_total[5m])) / (sum(rate(Tellura_cache_hits_total[5m])) + sum(rate(Tellura_cache_misses_total[5m])))",
          "legendFormat": "Cache Hit Ratio"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": { "drawStyle": "line" },
          "min": 0,
          "max": 1,
          "unit": "percentunit"
        }
      }
    },
    {
      "collapsed": false,
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 16 },
      "id": 7,
      "title": "Total Analysis Executions by Dataset",
      "type": "timeseries",
      "targets": [
        {
          "expr": "sum(rate(Tellura_analysis_operations_total[5m])) by (dataset, status)",
          "legendFormat": "{{dataset}} ({{status}})"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": { "drawStyle": "bars" },
          "unit": "ops"
        }
      }
    }
  ],
  "schemaVersion": 38,
  "style": "dark",
  "tags": ["Tellura", "nasa", "production", "sre"],
  "time": { "from": "now-1h", "to": "now" },
  "timepicker": { "refresh_intervals": ["5s", "10s", "30s", "1m", "5m"] },
  "timezone": "browser",
  "title": "NASA Tellura — SRE Production Telemetry & SLO Dashboard",
  "uid": "Tellura-prod-slo"
}
