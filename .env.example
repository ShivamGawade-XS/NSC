# =================================================================
# Tellura — NASA Earth System Trend Workstation Environment Config
# =================================================================

# -----------------------------------------------------------------
# 1. AI Scientific Copilot & NLQ Engines (Cascading Fallback)
# Priority: Google Gemini -> xAI Grok -> OpenAI -> Deterministic Template
# -----------------------------------------------------------------
# Primary: Google Gemini (Get key at https://aistudio.google.com)
GEMINI_API_KEY=

# Secondary Fallback: Groq Cloud (https://console.groq.com)
# OR xAI Grok (https://console.x.ai)
GROQ_API_KEY=
GROK_API_KEY=
XAI_API_KEY=

# Tertiary Fallback: OpenAI (https://platform.openai.com)
OPENAI_API_KEY=

# Daily external LLM spend/budget cap for anonymous tier (default: 200)
DAILY_LLM_CALL_LIMIT=200

# -----------------------------------------------------------------
# 2. Transactional Mailer (Gmail SMTP or Resend/SendGrid)
# Uses Python stdlib smtplib + SSL/TLS. Falls back to local JSON inbox if unset.
# -----------------------------------------------------------------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
CONTACT_RECIPIENT_EMAIL=

# -----------------------------------------------------------------
# 3. NASA Earthdata Login (EDL) (Optional: for direct cloud granule streaming)
# Register free at: https://urs.earthdata.nasa.gov
# -----------------------------------------------------------------
EARTHDATA_USERNAME=
EARTHDATA_PASSWORD=
EARTHDATA_TOKEN=

# -----------------------------------------------------------------
# 4. Server & Scientific Engine Configuration
# -----------------------------------------------------------------
ENVIRONMENT=development
# Cryptographic HMAC key for cache integrity (must be >= 32 characters in production)
SECRET_KEY=replace-with-a-random-32-character-secret-key-for-production
TELLURA_DB_PATH=
TELLURA_INBOX_DIR=
CACHE_MAX_SIZE=256
MAX_BBOX_DEGREES=180.0
DEFAULT_FDR_ALPHA=0.05
PORT=8000
HOST=127.0.0.1

# Zero-Synthetic Standard: blocks synthetic data generation everywhere
STRICT_ZERO_SYNTHETIC=true

# -----------------------------------------------------------------
# 5. Frontend & Telemetry Configuration
# -----------------------------------------------------------------
# Frontend API URL override (optional, defaults to window.location.origin/api/v1)
VITE_API_URL=
VITE_ANALYTICS_ENDPOINT=/api/v1/telemetry
