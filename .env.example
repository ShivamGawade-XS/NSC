# =================================================================
# EarthSift — NASA Earth System Trend Workstation Environment Config
# =================================================================

# -----------------------------------------------------------------
# 1. AI Scientific Copilot & NLQ Engines (Cascading Fallback)
# Priority: Google Gemini -> xAI Grok -> OpenAI -> Deterministic Template
# -----------------------------------------------------------------
# Primary: Google Gemini (Get key at https://aistudio.google.com)
GEMINI_API_KEY=

# Secondary Fallback: Groq Cloud (Free & Ultra-Fast, https://console.groq.com)
# OR xAI Grok (https://console.x.ai) - Auto-detected via key prefix (gsk_ vs xai-)
GROQ_API_KEY=
GROK_API_KEY=
XAI_API_KEY=

# Tertiary Fallback: OpenAI (Optional, get key at https://platform.openai.com)
OPENAI_API_KEY=

# Daily external LLM spend/budget cap for anonymous tier (default: 200)
DAILY_LLM_CALL_LIMIT=200

# -----------------------------------------------------------------
# 2. Transactional Mailer (Gmail SMTP or Resend/SendGrid)
# Uses Python stdlib smtplib + SSL/TLS. Falls back to local JSON inbox if unset.
# Generate 16-character Google App Password at: https://myaccount.google.com/security
# -----------------------------------------------------------------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=nsc26cs@gmail.com
SMTP_PASSWORD=
CONTACT_RECIPIENT_EMAIL=nsc26cs@gmail.com

# -----------------------------------------------------------------
# 3. NASA Earthdata Login (EDL) (Optional: for direct cloud granule streaming)
# Register free at: https://urs.earthdata.nasa.gov
# -----------------------------------------------------------------
EARTHDATA_USERNAME=
EARTHDATA_PASSWORD=
EARTHDATA_TOKEN=

# -----------------------------------------------------------------
# 4. Server & Scientific Engine Configuration
# -----------------------------------------------------------------
ENVIRONMENT=production
CACHE_MAX_SIZE=256
MAX_BBOX_DEGREES=180.0
DEFAULT_FDR_ALPHA=0.05
PORT=8000
HOST=0.0.0.0

# Zero-Synthetic Standard: blocks synthetic data generation everywhere
STRICT_ZERO_SYNTHETIC=true

# -----------------------------------------------------------------
# 5. Scientific Telemetry & Analytics
# -----------------------------------------------------------------
VITE_ANALYTICS_ENDPOINT=/api/v1/telemetry
