# =================================================================
# EarthSift — NASA Space Apps Challenge 2026 Environment Config
# =================================================================

# NASA Earthdata Login (Optional: For streaming live cloud granules)
# Register free at: https://urs.earthdata.nasa.gov
EARTHDATA_USERNAME=
EARTHDATA_PASSWORD=
EARTHDATA_TOKEN=

# Gemini / LLM Scientific Explainer (Optional: Deterministic fallback active if empty)
# Get key from: https://aistudio.google.com
GEMINI_API_KEY=

# Server & Runtime Configuration
ENVIRONMENT=production
CACHE_MAX_SIZE=256
MAX_BBOX_DEGREES=180.0
DEFAULT_FDR_ALPHA=0.05
PORT=8000
HOST=0.0.0.0

# Zero-Synthetic Standard: blocks synthetic data generation everywhere
STRICT_ZERO_SYNTHETIC=true

# SMTP Contact Form (optional — falls back to local JSON inbox if unset)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
CONTACT_RECIPIENT_EMAIL=shivamgawade.dev@gmail.com

# Analytics (optional — set to /api/v1/telemetry for self-hosted)
VITE_ANALYTICS_ENDPOINT=/api/v1/telemetry
